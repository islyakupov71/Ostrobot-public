# ============================================================
#  ОСТРО — переменные окружения
#  Скопируй в .env и заполни. .env в git не попадает.
# ============================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---------- Telegram ----------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-адрес API. В dev оставь пустым — бот пойдёт в long polling.
TELEGRAM_WEBHOOK_URL=
# Придумай любую длинную случайную строку: Telegram будет слать её в заголовке,
# чтобы никто посторонний не смог постучаться в наш webhook.
TELEGRAM_WEBHOOK_SECRET=
# Telegram ID первого администратора — он получит роль admin при первом запуске сидов.
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# ---------- База данных ----------
DATABASE_URL=

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=3000
# Публичный адрес Mini App (нужен для CORS и для кнопки в боте)
WEB_APP_URL=http://localhost:5173
# Секрет для подписи сессионных JWT. Сгенерируй: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Google Sheets ----------
# Email сервис-аккаунта из Google Cloud Console.
# Не забудь расшарить таблицу на этот email с правом «Редактор».
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватный ключ сервис-аккаунта. Переносы строк экранируй как \n,
# всю строку оберни в двойные кавычки.
GOOGLE_PRIVATE_KEY=""
# ID основной таблицы: берётся из её URL между /d/ и /edit.
# Нужен, только если привязываемся к уже существующей книге.
GOOGLE_SPREADSHEET_ID=

# Корневая папка на Диске, внутри которой живут все тендеры.
# Достаточно расшарить на служебный аккаунт ЕЁ ОДНУ — доступ к вложенным
# папкам и таблицам, включая созданные позже, появится автоматически.
# ID берётся из адреса папки после /folders/
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Таблица-образец, с которой копируется структура для нового тендера.
# Если не задана, бот создаёт пустую книгу и сам пишет заголовки.
GOOGLE_TEMPLATE_SPREADSHEET_ID=
# Общий секрет между Apps Script и нашим API (см. infra/apps-script/Code.gs)
SHEETS_WEBHOOK_SECRET=
# Как часто подтягивать таблицу целиком, на случай если webhook не долетел (сек)
SHEETS_POLL_INTERVAL_SEC=300

# ---------- Планировщик и напоминания ----------
DEFAULT_TIMEZONE=Europe/Moscow
# Тихие часы: в это время бот копит уведомления и отправляет их утром.
# Критические просрочки и эскалации руководителю приходят всегда.
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
